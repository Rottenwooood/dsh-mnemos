{
  "name": "dsh-mnemos",
  "version": "0.1.1",
  "description": "Cross-session memory with governance, self-evolution and an approval-gated write path for DeepSeek Harness. Heat-ranked recall, environment conventions, forgetting lifecycle, supersession chains, poisoning defense, auto-distillation, and an open measurement ABI.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "recall",
    "distill",
    "environment-conventions",
    "approval",
    "sqlite",
    "fts5"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rottenwooood/dsh-mnemos.git"
  },
  "homepage": "https://github.com/Rottenwooood/dsh-mnemos#readme",
  "bugs": {
    "url": "https://github.com/Rottenwooood/dsh-mnemos/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "!src/test",
    "lib",
    "docs/ARCHITECTURE.md",
    "scripts/run-verify.sh",
    "scripts/build-client.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:longmemeval": "BENCH_SKIP_ABS=1 BENCH_LIMIT=470 BENCH_OUT=scripts/bench/longmemeval-scorecard.json vitest run scripts/bench/longmemeval.bench.test.ts",
    "bench:locomo": "BENCH_OUT=scripts/bench/locomo-scorecard.json vitest run scripts/bench/locomo.bench.test.ts",
    "build": "pnpm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "verify": "bash scripts/run-verify.sh"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0",
    "isomorphic-git": "^1.41.9"
  }
}
